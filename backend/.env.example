# Token da Data Export API do Clarity (painel → Configurações → Configurações
# do projeto → API). Credencial única: já é do projeto, não existe Client ID
# nem Client Secret. Se ficar vazio, usa o token salvo por cada usuário.
CLARITY_EXPORT_TOKEN=

# Screenshot Service (opcional - se usar API externa)
SCREENSHOT_API_KEY=
SCREENSHOT_API_URL=https://api.screenshotone.com/take

# Web Push (VAPID) — notificações nativas de "PIX gerado"/"PIX pago".
# Gere um par com: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_pem().decode()); print(v.private_pem().decode())"
# Ou use https://web-push-codelab.glitch.me/
# Sem estas duas chaves o serviço de push fica mudo (nenhuma rota quebra).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contato obrigatório pelo protocolo Web Push (header VAPID `sub`).
VAPID_CONTACT_EMAIL=contato@funneltron.app

# Meta Marketing API (Facebook Ads) — rastreamento de criativos/campanhas.
# ⚠️ NÃO é variável de ambiente. As credenciais são configuradas por workspace
# via painel de integrações e salvas na tabela `api_credentials` (provider=utmfy).
# Formato do campo api_key: ACCESS_TOKEN|AD_ACCOUNT_ID
# Exemplo: EAABsbCS1cHgBA...|act_1234567890
# Permissões necessárias no token: ads_read, business_management
# Gerar token: https://developers.facebook.com/tools/explorer/

# Environment
ENVIRONMENT=production
