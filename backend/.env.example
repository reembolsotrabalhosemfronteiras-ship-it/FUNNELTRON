# Supabase — painel do projeto > Project Settings > API
# Sem estes três valores o backend cai no modo local (SQLite em backend/data).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=cole_aqui_a_anon_key
# ⚠️ service_role ignora todo o RLS. Só aqui e nas variáveis do servidor —
# nunca no frontend, nunca commitada.
SUPABASE_SERVICE_KEY=cole_aqui_a_service_role_key

# APIs (tokens ficam no banco, mas você pode colocar defaults aqui)
CLARITY_TOKEN=
VTURB_TOKEN=

# Screenshot Service (opcional - se usar API externa)
SCREENSHOT_API_KEY=
SCREENSHOT_API_URL=https://api.screenshotone.com/take

# Environment
ENVIRONMENT=production
